{
  "name": "@crosery/dsh-drop",
  "version": "0.1.2",
  "description": "Drag and paste files into dsh Web with a unified preview rail; keep native images and add file references only when sending.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "drag-and-drop",
    "attachment",
    "file-reference"
  ],
  "author": "Crosery",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets/**",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.test.json",
    "test": "node --test tests/*.test.ts",
    "check": "node scripts/check-invariants.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.1.2-0 || >=0.1.2-alpha.0 <0.1.3-0 || >=0.1.2-rc.0 <0.1.3-0 || >=0.1.3-alpha.0 <0.1.4-0 || >=0.1.3-rc.0 <0.1.4-0 || >=0.1.5-alpha.0 <0.1.6-0 || >=0.1.5-rc.0 <0.1.6-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.1.2-0 || >=0.1.2-alpha.0 <0.1.3-0 || >=0.1.2-rc.0 <0.1.3-0 || >=0.1.3-alpha.0 <0.1.4-0 || >=0.1.3-rc.0 <0.1.4-0 || >=0.1.5-alpha.0 <0.1.6-0 || >=0.1.5-rc.0 <0.1.6-0",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.1 <0.1.1-0 || >=0.1.1-rc.0 <0.1.2-0 || >=0.1.2-alpha.0 <0.1.3-0 || >=0.1.2-rc.0 <0.1.3-0 || >=0.1.3-alpha.0 <0.1.4-0 || >=0.1.3-rc.0 <0.1.4-0 || >=0.1.5-alpha.0 <0.1.6-0 || >=0.1.5-rc.0 <0.1.6-0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-api-remotes": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.7",
    "esbuild": "^0.28.0",
    "semver": "^7.7.2",
    "typescript": "^5.9.0"
  },
  "homepage": "https://github.com/Crosery/dsh-drop#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crosery/dsh-drop.git"
  },
  "bugs": {
    "url": "https://github.com/Crosery/dsh-drop/issues"
  },
  "engines": {
    "node": "^22.19 || >=24"
  }
}
